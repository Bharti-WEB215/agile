{
  "name": "restpos-backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:local": "node --env-file=.env.local --import tsx --watch src/index.ts",
    "start": "tsx src/index.ts",
    "prisma:generate": "prisma generate && prisma generate --schema prisma/local.prisma",
    "prisma:generate:local": "prisma generate --schema prisma/local.prisma",
    "prisma:push": "prisma db push --skip-generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "local:setup": "npm run prisma:generate:local && node --env-file=.env.local --import tsx prisma/bootstrapLocal.ts && node --env-file=.env.local --import tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "qs": "^6.16.1"
  }
}

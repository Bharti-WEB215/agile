// Local SQLite database for development environments where Docker is unavailable.
// The production schema remains PostgreSQL in schema.prisma.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/local-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id   Int    @id @default(autoincrement())
  name String
  role String

  @@map("users")
}

model Product {
  id         Int         @id @default(autoincrement())
  name       String
  price      Float
  category   String?
  isActive   Boolean     @default(true) @map("is_active")
  orderItems OrderItem[]

  @@map("products")
}

model Table {
  id            Int      @id @default(autoincrement())
  tableNo       String   @unique @map("table_no")
  qrToken       String   @unique @map("qr_token")
  isActive      Boolean  @default(true) @map("is_active")
  lastSettledAt DateTime @default(now()) @map("last_settled_at")
  orders        Order[]

  @@map("tables")
}

model Order {
  id          Int         @id @default(autoincrement())
  orderNumber String      @unique @map("order_number")
  totalAmount Float       @map("total_amount")
  createdAt   DateTime    @default(now()) @map("created_at")
  paymentMode String?     @map("payment_mode")
  status      String      @default("PENDING")
  source      String      @default("CASHIER")
  tableId     Int?        @map("table_id")
  table       Table?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  orderItems  OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  quantity  Int
  price     Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}
